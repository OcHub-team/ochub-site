---
import Mascot from "./Mascot.astro";
import { LINKS } from "@/data/site";
import { LOCALES, localeHome, type Locale, type Strings } from "@/i18n";

interface Props {
  locale: Locale;
  t: Strings;
}
const { locale, t } = Astro.props;
---

<header class="nav">
  <div class="wrap nav-inner">
    <a class="brand" href={localeHome(locale)} aria-label={t.a11y.home}>
      <Mascot />
      <span>OcHub</span>
    </a>
    <nav class="nav-links" aria-label={t.a11y.primaryNav}>
      <a href="#capabilities">{t.nav.capabilities}</a>
      <a href="#relay">{t.nav.relay}</a>
      <a href="#native">{t.nav.native}</a>
      <a href="#download">{t.nav.download}</a>
      <a href={LINKS.docs.overview}>{t.nav.docs}</a>
    </nav>
    <div class="nav-right">
      <details class="locale-menu" id="localeMenu">
        <summary aria-label={t.a11y.language} title={t.a11y.language}>
          {locale.label}
          <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"
            ><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg
          >
        </summary>
        <div class="locale-pop">
          {
            LOCALES.map((l) => (
              <a href={localeHome(l)} aria-current={l.key === locale.key ? "true" : undefined}>
                {l.label}
              </a>
            ))
          }
        </div>
      </details>
      <button
        class="icon-btn"
        id="themeToggle"
        type="button"
        aria-label={`${t.a11y.themeLabel}: ${t.a11y.themeModes.auto}`}
        title={`${t.a11y.themeLabel}: ${t.a11y.themeModes.auto}`}
        data-theme-label={t.a11y.themeLabel}
        data-mode-auto={t.a11y.themeModes.auto}
        data-mode-light={t.a11y.themeModes.light}
        data-mode-dark={t.a11y.themeModes.dark}
      >
        <svg data-theme-icon="auto" viewBox="0 0 24 24" fill="none" aria-hidden="true"
          ><circle cx="12" cy="12" r="8.5" stroke="currentColor" stroke-width="1.7"></circle><path d="M12 3.5a8.5 8.5 0 010 17z" fill="currentColor"></path></svg
        >
        <svg data-theme-icon="light" viewBox="0 0 24 24" fill="none" aria-hidden="true" style="display:none"
          ><circle cx="12" cy="12" r="4.2" stroke="currentColor" stroke-width="1.7"></circle><path d="M12 2.8v2.4M12 18.8v2.4M2.8 12h2.4M18.8 12h2.4M5 5l1.7 1.7M17.3 17.3L19 19M19 5l-1.7 1.7M6.7 17.3L5 19" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"></path></svg
        >
        <svg data-theme-icon="dark" viewBox="0 0 24 24" fill="none" aria-hidden="true" style="display:none"
          ><path d="M20 14.5A8.5 8.5 0 019.5 4a8.5 8.5 0 1010.5 10.5z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"></path></svg
        >
      </button>
      <a class="icon-btn" href={LINKS.repo} aria-label={t.a11y.github} title="GitHub">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
          ><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.55 0-.27-.01-1.17-.02-2.12-3.2.7-3.87-1.36-3.87-1.36-.52-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.03 1.76 2.69 1.25 3.35.96.1-.75.4-1.25.72-1.54-2.55-.29-5.23-1.28-5.23-5.68 0-1.26.45-2.28 1.18-3.09-.12-.29-.51-1.46.11-3.05 0 0 .96-.31 3.15 1.18a10.9 10.9 0 015.74 0c2.19-1.49 3.15-1.18 3.15-1.18.62 1.59.23 2.76.11 3.05.73.81 1.18 1.83 1.18 3.09 0 4.41-2.69 5.38-5.25 5.67.41.35.77 1.05.77 2.12 0 1.53-.01 2.76-.01 3.14 0 .3.2.66.8.55A11.51 11.51 0 0023.5 12C23.5 5.65 18.35.5 12 .5z"></path></svg
        >
      </a>
      <a class="btn btn-primary btn-small" href="#download">{t.nav.cta}</a>
    </div>
  </div>
</header>

<style>
  .nav {
    position: sticky; top: 0; z-index: 50;
    backdrop-filter: blur(14px) saturate(1.3);
    -webkit-backdrop-filter: blur(14px) saturate(1.3);
    background: color-mix(in oklch, var(--bg) 78%, transparent);
    border-bottom: 1px solid var(--border);
  }
  .nav-inner {
    display: flex; align-items: center; gap: 28px;
    height: 60px;
  }
  .brand { display: flex; align-items: center; gap: 10px; text-decoration: none; color: var(--text); }
  /* Mascot renders through the child component — scoped styles need :global. */
  .brand :global(svg) { width: 30px; height: auto; display: block; }
  .brand span { font-family: var(--font-display); font-weight: 600; font-size: 1.14rem; letter-spacing: -0.01em; }
  .nav-links { display: flex; gap: 26px; margin-left: 12px; }
  .nav-links a {
    color: var(--subtext); text-decoration: none; font-size: 0.94rem;
    transition: color 0.18s var(--ease-out);
  }
  .nav-links a:hover { color: var(--text); }
  .nav-right { margin-left: auto; display: flex; align-items: center; gap: 8px; }

  /* locale menu: <details>-based, works without JS (JS adds outside-close) */
  .locale-menu { position: relative; }
  .locale-menu summary {
    display: inline-flex; align-items: center; gap: 5px;
    font-size: 0.85rem; color: var(--subtext);
    padding: 6px 10px; border-radius: 9px; border: 1px solid transparent;
    background: none; cursor: pointer; font-family: var(--font-body);
    list-style: none; user-select: none;
  }
  .locale-menu summary::-webkit-details-marker { display: none; }
  .locale-menu summary:hover { background: var(--inset); color: var(--text); }
  .locale-menu summary svg { width: 12px; height: 12px; }
  .locale-menu[open] summary { background: var(--inset); color: var(--text); }
  .locale-pop {
    position: absolute; right: 0; top: calc(100% + 6px); z-index: 60;
    min-width: 132px;
    background: var(--surface); border: 1px solid var(--border);
    border-radius: 10px; padding: 5px;
    box-shadow: 0 12px 32px -12px color-mix(in oklch, var(--text) 30%, transparent);
    display: flex; flex-direction: column;
  }
  .locale-pop a {
    padding: 7px 11px; border-radius: 7px; font-size: 0.9rem;
    color: var(--subtext); text-decoration: none;
  }
  .locale-pop a:hover { background: var(--inset); color: var(--text); }
  .locale-pop a[aria-current="true"] { color: var(--teal-ink); font-weight: 500; }

  @media (max-width: 640px) {
    .nav-links { display: none; }
  }
</style>
