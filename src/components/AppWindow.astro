---
/**
 * Pure-CSS replica of the shipped GPUI app, drawn from the real UI strings
 * (crates/app/i18n). Deliberately always light: the app ships a light UI
 * today (dark mode is architected but not shipped), so this window stays
 * honest — and pops nicely against the dark page theme.
 */
interface Props {
  alt: string;
}
const { alt } = Astro.props;
---

<div class="appwin" role="img" aria-label={alt}>
  <div class="appwin-titlebar">
    <span class="tl r"></span><span class="tl y"></span><span class="tl g"></span>
    <span class="t">OcHub</span>
  </div>
  <div class="appwin-body">
    <div class="appwin-side">
      <div class="side-group">
        <div class="side-label">Apps</div>
        <div class="side-row active"><span class="sd"></span>Claude Code</div>
        <div class="side-row"><span class="sd"></span>Claude Desktop</div>
        <div class="side-row"><span class="sd"></span>Codex</div>
        <div class="side-row"><span class="sd"></span>OpenCode</div>
        <div class="side-row"><span class="sd"></span>OpenClaw</div>
        <div class="side-row"><span class="sd"></span>Hermes</div>
      </div>
      <div class="side-group">
        <div class="side-label">Network</div>
        <div class="side-row"><span class="sd"></span>Relay</div>
      </div>
      <div class="side-group">
        <div class="side-label">System</div>
        <div class="side-row"><span class="sd"></span>Usage</div>
        <div class="side-row"><span class="sd"></span>Settings</div>
      </div>
    </div>
    <div class="appwin-main">
      <div class="crumb">Apps<b>Claude Code</b></div>
      <div class="conn-hero">
        <span class="live"></span>
        <div>
          <div class="n">Team relay <span class="badge cur">Current</span></div>
          <div class="u">127.0.0.1 · default model claude-sonnet-4-5</div>
        </div>
        <div class="seg"><span>Direct</span><span class="on">Relay</span></div>
      </div>
      <div class="list-label">Direct connections</div>
      <div class="conn-row">
        <span class="grip">⋮⋮</span>
        <div><div class="n">Anthropic · Pro</div><div class="u">api.anthropic.com</div></div>
        <span class="badge dir">Direct</span>
        <span class="sw">Switch</span>
      </div>
      <div class="conn-row">
        <span class="grip">⋮⋮</span>
        <div><div class="n">OpenAI · GPT-5.5</div><div class="u">api.openai.com</div></div>
        <span class="badge dir">Direct</span>
        <span class="sw">Switch</span>
      </div>
      <div class="conn-row relay">
        <span class="grip">⋮⋮</span>
        <div><div class="n">Team relay</div><div class="u">3 model mappings · failover on</div></div>
        <span class="badge rel">Relay mode</span>
        <span class="sw">Manage</span>
      </div>
      <div class="conn-add">+ Add a direct connection</div>
      <div class="appwin-status">
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"
          ><path d="M4 12.5l5 5L20 6.5" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"></path></svg
        >
        All changes saved
        <span class="v">v0.2.3</span>
      </div>
    </div>
  </div>
</div>

<style>
  /* App tokens — fixed light palette, mirroring crates/app/src/theme.rs. */
  .appwin {
    --app-bg: #fcfcfb; --app-mantle: #f4f4f2; --app-surface: #ffffff;
    --app-panel: #f8f8f6; --app-border: #e7e6e2; --app-border2: #d6d5d0;
    --app-text: #222019; --app-sub: #6b6a64; --app-muted: #91908a;
    --app-teal: #157a78; --app-teal-soft: #e4f4f3; --app-green: #1d9e57;

    position: relative; z-index: 2;
    background: var(--app-surface);
    border: 1px solid var(--app-border);
    border-radius: var(--radius);
    box-shadow:
      0 1px 2px rgb(24 22 14 / 0.04),
      0 12px 32px -8px rgb(24 22 14 / 0.10),
      0 40px 90px -24px rgb(24 22 14 / 0.16);
    overflow: hidden;
    font-size: 10.5px; line-height: 1.45;
    color: var(--app-text);
    transform: rotate(0.4deg);
  }
  .appwin-titlebar {
    height: 34px; display: flex; align-items: center; gap: 8px;
    padding: 0 12px; background: var(--app-mantle);
    border-bottom: 1px solid var(--app-border);
  }
  .tl { width: 10px; height: 10px; border-radius: 50%; }
  .tl.r { background: #ff5f57; } .tl.y { background: #febc2e; } .tl.g { background: #28c840; }
  .appwin-titlebar .t {
    margin-left: 8px; color: var(--app-sub); font-weight: 500; letter-spacing: 0.01em;
  }
  .appwin-body { display: grid; grid-template-columns: 138px minmax(0, 1fr); min-height: 300px; }
  .appwin-side {
    background: var(--app-mantle); border-right: 1px solid var(--app-border);
    padding: 10px 8px;
  }
  .side-group { margin-bottom: 12px; }
  .side-label {
    font-size: 8.5px; text-transform: uppercase; letter-spacing: 0.09em;
    color: var(--app-muted); padding: 0 8px 4px; font-weight: 600;
  }
  .side-row {
    display: flex; align-items: center; gap: 6px;
    padding: 4px 8px; border-radius: 6px; color: var(--app-sub);
    font-weight: 500; white-space: nowrap;
  }
  .side-row .sd { width: 5px; height: 5px; border-radius: 50%; background: var(--app-border2); flex: none; }
  .side-row.active { background: var(--app-surface); color: var(--app-text); box-shadow: inset 0 0 0 1px var(--app-border); }
  .side-row.active .sd { background: var(--app-green); }
  .appwin-main { padding: 13px 15px 0; display: flex; flex-direction: column; min-width: 0; }
  .appwin-main .u, .conn-hero .u, .conn-row .u {
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 100%;
  }
  .conn-hero > div, .conn-row > div { min-width: 0; }
  .crumb { color: var(--app-muted); font-size: 9.5px; }
  .crumb b { color: var(--app-text); font-weight: 600; font-size: 12.5px; display: block; margin-top: 1px; }
  .conn-hero {
    margin-top: 9px; background: var(--app-panel);
    border: 1px solid var(--app-border); border-radius: 9px; padding: 9px 11px;
    display: flex; align-items: center; gap: 9px;
  }
  .conn-hero .live { width: 7px; height: 7px; border-radius: 50%; background: var(--app-green); flex: none; }
  .conn-hero .n { font-weight: 600; font-size: 11.5px; }
  .conn-hero .u { color: var(--app-muted); font-family: var(--font-mono); font-size: 8.5px; }
  .badge {
    display: inline-flex; align-items: center; border-radius: 999px;
    font-size: 8px; font-weight: 600; letter-spacing: 0.04em; padding: 2px 7px;
  }
  .badge.cur { background: var(--app-teal-soft); color: var(--app-teal); }
  .seg {
    margin-left: auto; display: inline-flex; background: var(--app-mantle);
    border: 1px solid var(--app-border); border-radius: 7px; padding: 2px; gap: 2px; flex: none;
  }
  .seg span { padding: 2.5px 9px; border-radius: 5px; font-weight: 500; color: var(--app-sub); }
  .seg span.on { background: var(--app-surface); color: var(--app-text); box-shadow: 0 1px 2px rgb(0 0 0 / 0.08); }
  .list-label {
    margin: 11px 0 5px; font-size: 8.5px; text-transform: uppercase;
    letter-spacing: 0.09em; color: var(--app-muted); font-weight: 600;
  }
  .conn-row {
    display: flex; align-items: center; gap: 8px;
    padding: 6.5px 9px; border: 1px solid var(--app-border);
    border-radius: 8px; margin-bottom: 5px; background: var(--app-surface);
  }
  .conn-row .grip { color: var(--app-border2); font-family: var(--font-mono); letter-spacing: -1px; font-size: 9px; }
  .conn-row .n { font-weight: 500; }
  .conn-row .u { color: var(--app-muted); font-family: var(--font-mono); font-size: 8.5px; }
  .badge.dir { background: var(--app-mantle); color: var(--app-sub); border: 1px solid var(--app-border); }
  .badge.rel { background: var(--app-teal-soft); color: var(--app-teal); }
  .conn-row .sw {
    margin-left: auto; border: 1px solid var(--app-border2); border-radius: 6px;
    padding: 2.5px 9px; font-weight: 500; color: var(--app-sub); background: var(--app-surface); flex: none;
  }
  .conn-row.relay { border-color: #bfe3e1; background: #f2fafa; }
  .conn-add {
    border: 1px dashed var(--app-border2); border-radius: 8px;
    padding: 6px 9px; color: var(--app-muted); text-align: center; font-weight: 500;
  }
  .appwin-status {
    margin-top: auto; border-top: 1px solid var(--app-border);
    padding: 6px 15px; display: flex; align-items: center; gap: 6px;
    color: var(--app-muted); font-size: 9px;
  }
  .appwin-status svg { width: 10px; height: 10px; color: var(--app-green); }
  .appwin-status .v { margin-left: auto; font-family: var(--font-mono); }

  @media (max-width: 640px) {
    .appwin { font-size: 9.5px; }
    .appwin-body { grid-template-columns: 112px minmax(0, 1fr); }
  }
</style>
