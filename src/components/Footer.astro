---
import Mascot from "./Mascot.astro";
import { LINKS } from "@/data/site";
import { LOCALES, localeHome, type Locale, type Strings } from "@/i18n";

interface Props {
  locale: Locale;
  t: Strings;
}
const { locale, t } = Astro.props;

const PRODUCT_LINKS = [
  { label: "Overview", href: LINKS.docs.overview },
  { label: "Install", href: LINKS.docs.install },
  { label: "Architecture", href: LINKS.docs.architecture },
  { label: "Build from source", href: LINKS.docs.buildFromSource },
];

const PROJECT_LINKS = [
  { label: "GitHub", href: LINKS.repo },
  { label: "Releases", href: LINKS.allReleases },
  { label: "Homebrew tap", href: LINKS.brewTap },
  { label: "GPL-3.0-or-later", href: LINKS.license },
];
---

<footer>
  <div class="wrap">
    <div class="foot-grid">
      <div class="foot-brand">
        <Mascot notch="var(--mantle)" />
        <p>{t.footer.tagline}</p>
      </div>
      <div>
        <div class="foot-h">{t.footer.product}</div>
        <div class="foot-links">
          {PRODUCT_LINKS.map((l) => <a href={l.href}>{l.label}</a>)}
        </div>
      </div>
      <div>
        <div class="foot-h">{t.footer.project}</div>
        <div class="foot-links">
          {PROJECT_LINKS.map((l) => <a href={l.href}>{l.label}</a>)}
        </div>
      </div>
      <div>
        <div class="foot-h">{t.footer.language}</div>
        <div class="foot-locales">
          {
            LOCALES.map((l) => (
              <a href={localeHome(l)} aria-current={l.key === locale.key ? "true" : undefined}>
                {l.label}
              </a>
            ))
          }
        </div>
      </div>
    </div>
    <div class="foot-base">
      <span>{t.footer.copyright}</span>
      <span>
        {t.footer.creditLead}
        <a href={LINKS.ccSwitch}>cc-switch</a>.
      </span>
      <span class="r">{t.footer.stack}</span>
    </div>
  </div>
</footer>

<style>
  footer { border-top: 1px solid var(--border); background: var(--mantle); }
  .foot-grid {
    padding: clamp(44px, 6vh, 64px) 0 34px;
    display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 2.5fr) minmax(0, 2.5fr) minmax(0, 2fr);
    gap: clamp(28px, 4vw, 56px);
  }
  /* Mascot renders through the child component — scoped styles need :global. */
  .foot-brand :global(svg) { width: 38px; height: auto; display: block; }
  .foot-brand p { margin-top: 14px; color: var(--subtext); font-size: 0.9rem; max-width: 36ch; }
  .foot-h { font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); margin-bottom: 14px; }
  .foot-links { display: flex; flex-direction: column; gap: 9px; }
  .foot-links a { color: var(--subtext); text-decoration: none; font-size: 0.93rem; }
  .foot-links a:hover { color: var(--text); }
  .foot-locales { display: flex; flex-direction: column; gap: 9px; }
  .foot-locales a {
    color: var(--subtext); font-size: 0.93rem; text-decoration: none;
  }
  .foot-locales a[aria-current="true"] { color: var(--teal-ink); font-weight: 500; }
  .foot-locales a:hover { color: var(--text); }
  .foot-base {
    border-top: 1px solid var(--border); padding: 20px 0 26px;
    display: flex; gap: 18px; flex-wrap: wrap; align-items: center;
    color: var(--muted); font-size: 0.84rem;
  }
  .foot-base a { color: var(--muted); }
  .foot-base .r { margin-left: auto; font-family: var(--font-mono); font-size: 0.78rem; }

  @media (max-width: 1020px) {
    .foot-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 640px) {
    .foot-grid { grid-template-columns: 1fr; }
  }
</style>
