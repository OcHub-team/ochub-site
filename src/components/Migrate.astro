---
import { LINKS } from "@/data/site";
---

<section class="migrate">
  <div class="wrap">
    <div class="migrate-card" data-reveal>
      <div>
        <div class="mq">Coming from cc-switch?</div>
        <p>
          A one-time, read-only import brings your providers over. OcHub owns
          <code>~/.ochub/</code> and never writes back to <code>~/.cc-switch/</code> —
          quit cc-switch before your first switch.
        </p>
      </div>
      <a class="btn btn-ghost" href={LINKS.docs.overview}>Read the migration notes</a>
    </div>
  </div>
</section>

<style>
  .migrate { padding: 0 0 clamp(72px, 10vh, 120px); }
  .migrate-card {
    border: 1px solid var(--border); border-radius: var(--radius);
    background: var(--surface);
    padding: clamp(22px, 3vw, 34px) clamp(24px, 3.4vw, 40px);
    display: flex; align-items: center; gap: clamp(20px, 3vw, 36px); flex-wrap: wrap;
  }
  .migrate-card .mq {
    font-family: var(--font-display); font-weight: 600; font-size: 1.3rem; letter-spacing: -0.01em;
  }
  .migrate-card p { color: var(--subtext); font-size: 0.95rem; max-width: 52ch; margin-top: 4px; }
  .migrate-card code { font-size: 0.82em; background: var(--inset); padding: 1.5px 6px; border-radius: 5px; }
  .migrate-card .btn { margin-left: auto; }

  @media (max-width: 640px) {
    .migrate-card .btn { margin-left: 0; }
  }
</style>
