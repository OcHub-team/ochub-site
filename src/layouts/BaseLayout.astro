---
/**
 * HTML shell: fonts, metadata, hreflang set, and the no-FOUC theme
 * bootstrap. The theme must be applied before first paint, so the
 * bootstrap is an inline (unbundled) script in <head>.
 */
import "@fontsource-variable/space-grotesk";
import "@fontsource-variable/jetbrains-mono";
import "@fontsource/ibm-plex-sans/400.css";
import "@fontsource/ibm-plex-sans/500.css";
import "@fontsource/ibm-plex-sans/600.css";
import "@/styles/global.css";
import { LOCALES, localeHome, type Locale } from "@/i18n";

interface Props {
  title: string;
  description: string;
  locale: Locale;
  skipToContent: string;
}

const { title, description, locale, skipToContent } = Astro.props;
const canonical = new URL(localeHome(locale), Astro.site);
const alternates = [
  ...LOCALES.map((l) => ({ tag: l.tag, href: new URL(localeHome(l), Astro.site) })),
  { tag: "x-default", href: new URL(localeHome(LOCALES[0]), Astro.site) },
];
---

<!doctype html>
<html lang={locale.tag}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.tag} href={a.href} />)}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <script is:inline>
      // Apply an explicit theme before first paint. Precedence:
      // ?theme=light|dark (QA/screenshots) > localStorage > system.
      (function () {
        var p = new URLSearchParams(location.search).get("theme");
        var s = null;
        try { s = localStorage.getItem("ochub-theme"); } catch (e) {}
        var m = p === "light" || p === "dark" ? p : s === "light" || s === "dark" ? s : null;
        if (m) document.documentElement.setAttribute("data-theme", m);
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">{skipToContent}</a>
    <slot />
  </body>
</html>
